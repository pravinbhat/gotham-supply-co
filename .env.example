# Copy to .env (gitignored). Every service reads Temporal settings via the SDK's
# envconfig loader, so these same variables work for Go, Java, Python and TypeScript.
#
# Temporal Cloud with an API key:
TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_API_KEY=<api-key>
#
# ...or mTLS instead of an API key:
# TEMPORAL_TLS_CLIENT_CERT_PATH=/path/to/client.pem
# TEMPORAL_TLS_CLIENT_KEY_PATH=/path/to/client.key
#
# ...or a named profile from ~/.config/temporalio/temporal.toml:
# TEMPORAL_PROFILE=cloud
#
# Leave all of the above unset to use a local `temporal server start-dev`.

# Service URLs (defaults shown)
BILLING_URL=http://localhost:8082
ARMORY_URL=http://localhost:8083
